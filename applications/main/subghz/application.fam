App(
    appid="subghz",
    name="Sub-GHz",
    apptype=FlipperAppType.MENUEXTERNAL,
    targets=["f7"],
    entry_point="subghz_app",
    icon="A_Sub1ghz_14",
    stack_size=3 * 1024,
    order=10,
    requires=["region"],
    resources="resources",
    fap_libs=["assets", "hwdrivers"],
    fap_private_libs=[
        Lib(name="subghz"),
    ],
    fap_icon="icon.png",
    fap_category="Sub-GHz",
    # ForceXIP: demand-stream .text from flash rather than copying the
    # whole ~600 KB fap into RAM. The timing-sensitive pulse capture +
    # DMA path lives in furi_hal (always in SRAM), so the FAP-side
    # decoder threads can tolerate XIP prefetch latency. Keeps SubGHz
    # loadable after Moon Companion's ~5.5 KB at-idle overhead landed.
    flags=["ForceXIP"],
)

App(
    appid="subghz_gps",
    targets=["f7"],
    apptype=FlipperAppType.PLUGIN,
    entry_point="subghz_gps_plugin_ep",
    requires=["subghz_gps"],
    sources=["helpers/subghz_gps.c", "helpers/minmea.c"],
)

App(
    appid="cli_subghz",
    targets=["f7"],
    apptype=FlipperAppType.PLUGIN,
    entry_point="cli_subghz_ep",
    requires=["cli"],
    sources=["subghz_cli.c", "helpers/subghz_chat.c"],
)
