# nanopb size constraints for moon_companion.proto
#
# Everything must fit in a single GATT notification (up to 244 bytes on a
# 247-byte MTU link). HTTP response bodies over ~4 KB travel on an L2CAP
# CoC side-channel; everything else is inline.

# ── Envelopes ──────────────────────────────────────────────────────────
*MoonRequest.auth_token       max_size:16
*PairRequest.flipper_name     max_size:32
*PairResponse.auth_token      max_size:16
*PairResponse.phone_name      max_size:32

# ── Position ──────────────────────────────────────────────────────────
*PositionData.source_id       max_size:8

# ── Time ──────────────────────────────────────────────────────────────
*TimeData.tz_name             max_size:48

# ── Notifications ─────────────────────────────────────────────────────
*SendNotificationRequest.title  max_size:64
*SendNotificationRequest.body   max_size:160
*SendNotificationRequest.tag    max_size:32

# ── Bulk transfer side-channel ────────────────────────────────────────
*OpenBulkChannelRequest.name         max_size:64
*OpenBulkChannelResponse.session_id  max_size:8
*CloseBulkChannelRequest.session_id  max_size:8

# ── HTTP proxy ────────────────────────────────────────────────────────
# Request: headers capped so an envelope fits in a handful of GATT
# notifications. Body capped at 2 KB inline — anything larger means the
# caller should restructure or use a streaming POST (not yet supported).
# Response: body inline cap 4 KB; above this the phone signals bulk and
# streams over CoC.
*HttpRequest.method           max_size:8
*HttpRequest.url              max_size:256
*HttpRequest.headers          max_count:8
*HttpRequest.body             max_size:2048
*HttpHeader.key               max_size:48
*HttpHeader.value             max_size:192
*HttpResponse.headers         max_count:8
*HttpResponse.body            max_size:4096
*HttpResponse.session_id      max_size:8
